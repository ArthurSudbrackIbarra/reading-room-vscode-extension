{
  "name": "markdown-pdf-viewer",
  "displayName": "Document Viewer & Highlighter",
  "description": "Read Markdown, text and PDF files as PDFs inside VS Code. Highlight in five colors, add notes, draw, type and erase on the page, mark where you stopped reading, play relaxing rain, fireplace or your own sounds, undo with Ctrl+Z, and download with all of it as PDF annotations.",
  "version": "0.8.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArthurSudbrackIbarra/markdown-pdf-viewer.git"
  },
  "icon": "media/icon.png",
  "private": true,
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "pdf",
    "markdown",
    "txt",
    "viewer",
    "reader",
    "highlight",
    "annotation",
    "notes",
    "drawing",
    "text box",
    "bookmark",
    "reading",
    "ambient sounds"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:markdownPdfViewer.preview",
    "onCustomEditor:markdownPdfViewer.pdf"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdownPdfViewer.openPreviewToSide",
        "title": "Open PDF Preview to the Side",
        "category": "Document Viewer",
        "icon": "$(file-pdf)"
      },
      {
        "command": "markdownPdfViewer.openPreview",
        "title": "Open PDF Preview",
        "category": "Document Viewer",
        "icon": "$(file-pdf)"
      },
      {
        "command": "markdownPdfViewer.showSource",
        "title": "Open Source File",
        "category": "Document Viewer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "markdownPdfViewer.toggleFullView",
        "title": "Toggle PDF Full View",
        "category": "Document Viewer",
        "icon": "$(screen-full)"
      },
      {
        "command": "markdownPdfViewer.refresh",
        "title": "Refresh PDF",
        "category": "Document Viewer",
        "icon": "$(refresh)"
      },
      {
        "command": "markdownPdfViewer.download",
        "title": "Download PDF",
        "category": "Document Viewer",
        "icon": "$(desktop-download)"
      },
      {
        "command": "markdownPdfViewer.downloadWithoutHighlights",
        "title": "Download PDF without Annotations",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.zoomIn",
        "title": "Zoom In (PDF)",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.zoomOut",
        "title": "Zoom Out (PDF)",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.zoomReset",
        "title": "Reset Zoom (PDF)",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.toggleHighlightTool",
        "title": "Toggle Highlight Tool",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.toggleHighlightsList",
        "title": "Toggle Annotations List",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.toggleDrawing",
        "title": "Toggle Drawing",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.toggleText",
        "title": "Toggle Adding Text",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.toggleEraser",
        "title": "Toggle Eraser",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.toggleDarkMode",
        "title": "Toggle Light/Dark Pages",
        "category": "Document Viewer",
        "icon": "$(color-mode)"
      },
      {
        "command": "markdownPdfViewer.undo",
        "title": "Undo Highlight, Note, Marker, Drawing or Text Change",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.redo",
        "title": "Redo Highlight, Note, Marker, Drawing or Text Change",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.markReadingPosition",
        "title": "Mark Where I Stopped Reading",
        "category": "Document Viewer",
        "icon": "$(bookmark)"
      },
      {
        "command": "markdownPdfViewer.goToReadingPosition",
        "title": "Go to Where I Stopped Reading",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.removeReadingPosition",
        "title": "Remove the Reading Marker",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.toggleSounds",
        "title": "Play/Pause Reading Sounds",
        "category": "Document Viewer",
        "icon": "$(unmute)"
      },
      {
        "command": "markdownPdfViewer.addSounds",
        "title": "Add Reading Sounds from Files…",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.reattachHighlights",
        "title": "Reattach Highlights from Another File…",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.deleteAllHighlights",
        "title": "Delete All Highlights for This File",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.deleteAllDrawings",
        "title": "Delete All Drawings for This File",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.deleteAllTextBoxes",
        "title": "Delete All Text Boxes for This File",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.revealDataFolder",
        "title": "Reveal Highlight Data Folder",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.clearCache",
        "title": "Clear Cached PDFs",
        "category": "Document Viewer"
      },
      {
        "command": "markdownPdfViewer.showLog",
        "title": "Show Log",
        "category": "Document Viewer"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownPdfViewer.openPreviewToSide",
          "alt": "markdownPdfViewer.openPreview",
          "group": "navigation",
          "when": "(resourceLangId == markdown || resourceFilename =~ /\\.txt$/i) && config.markdownPdfViewer.defaultOpenMode != 'full'"
        },
        {
          "command": "markdownPdfViewer.openPreview",
          "alt": "markdownPdfViewer.openPreviewToSide",
          "group": "navigation",
          "when": "(resourceLangId == markdown || resourceFilename =~ /\\.txt$/i) && config.markdownPdfViewer.defaultOpenMode == 'full'"
        },
        {
          "command": "markdownPdfViewer.showSource",
          "group": "navigation",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview'"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownPdfViewer.openPreviewToSide",
          "group": "navigation@90",
          "when": "resourceLangId == markdown || resourceExtname =~ /^\\.(txt|pdf)$/i"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownPdfViewer.openPreviewToSide",
          "when": "editorLangId == markdown || resourceFilename =~ /\\.txt$/i || resourceLangId == markdown || resourceFilename =~ /\\.txt$/i"
        },
        {
          "command": "markdownPdfViewer.openPreview",
          "when": "editorLangId == markdown || resourceFilename =~ /\\.txt$/i || resourceLangId == markdown || resourceFilename =~ /\\.txt$/i"
        },
        {
          "command": "markdownPdfViewer.showSource",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview'"
        },
        {
          "command": "markdownPdfViewer.toggleFullView",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview'"
        },
        {
          "command": "markdownPdfViewer.refresh",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.download",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.downloadWithoutHighlights",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.zoomIn",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.zoomOut",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.zoomReset",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.toggleHighlightTool",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.toggleHighlightsList",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.toggleDrawing",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.toggleText",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.toggleEraser",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.toggleDarkMode",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.undo",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.redo",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.markReadingPosition",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.goToReadingPosition",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.removeReadingPosition",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.toggleSounds",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf' || markdownPdfViewer.soundPlaying"
        },
        {
          "command": "markdownPdfViewer.reattachHighlights",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.deleteAllHighlights",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.deleteAllDrawings",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        },
        {
          "command": "markdownPdfViewer.deleteAllTextBoxes",
          "when": "activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdownPdfViewer.openPreviewToSide",
        "key": "ctrl+k shift+p",
        "mac": "cmd+k shift+p",
        "when": "editorLangId == markdown || resourceFilename =~ /\\.txt$/i"
      },
      {
        "command": "markdownPdfViewer.openPreview",
        "key": "ctrl+shift+alt+p",
        "mac": "cmd+shift+alt+p",
        "when": "editorLangId == markdown || resourceFilename =~ /\\.txt$/i"
      },
      {
        "command": "markdownPdfViewer.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "(activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf') && markdownPdfViewer.viewerFocused"
      },
      {
        "command": "markdownPdfViewer.zoomIn",
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "when": "(activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf') && markdownPdfViewer.viewerFocused"
      },
      {
        "command": "markdownPdfViewer.zoomIn",
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "when": "(activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf') && markdownPdfViewer.viewerFocused"
      },
      {
        "command": "markdownPdfViewer.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "(activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf') && markdownPdfViewer.viewerFocused"
      },
      {
        "command": "markdownPdfViewer.zoomOut",
        "key": "ctrl+shift+-",
        "mac": "cmd+shift+-",
        "when": "(activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf') && markdownPdfViewer.viewerFocused"
      },
      {
        "command": "markdownPdfViewer.zoomOut",
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "when": "(activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf') && markdownPdfViewer.viewerFocused"
      },
      {
        "command": "markdownPdfViewer.zoomReset",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "(activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf') && markdownPdfViewer.viewerFocused"
      },
      {
        "command": "markdownPdfViewer.zoomReset",
        "key": "ctrl+numpad0",
        "mac": "cmd+numpad0",
        "when": "(activeWebviewPanelId == 'markdownPdfViewer.preview' || activeCustomEditorId == 'markdownPdfViewer.pdf') && markdownPdfViewer.viewerFocused"
      }
    ],
    "configuration": {
      "title": "Document Viewer",
      "properties": {
        "markdownPdfViewer.defaultOpenMode": {
          "type": "string",
          "enum": [
            "side",
            "full"
          ],
          "enumDescriptions": [
            "The title-bar button opens the PDF next to the Markdown or text editor. Alt+click opens it in the current editor group.",
            "The title-bar button opens the PDF in the current editor group. Alt+click opens it to the side."
          ],
          "default": "side",
          "scope": "application",
          "description": "What the PDF button in the editor title bar does on a plain click."
        },
        "markdownPdfViewer.pageSize": {
          "type": "string",
          "enum": [
            "A4",
            "Letter"
          ],
          "default": "A4",
          "scope": "application",
          "description": "Paper size of the PDF made from Markdown and text files."
        },
        "markdownPdfViewer.pageNumbers": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Print page numbers (\"n / N\") at the bottom of every page."
        },
        "markdownPdfViewer.renderOnSave": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Convert Markdown and text files again automatically when they are saved."
        },
        "markdownPdfViewer.allowRemoteImages": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Download http(s) images referenced by the Markdown and embed them in the PDF."
        },
        "markdownPdfViewer.chromiumPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to a Chrome, Edge or Chromium executable. Leave empty to detect an installed browser automatically."
        },
        "markdownPdfViewer.chromiumDownload": {
          "type": "string",
          "enum": [
            "ask",
            "never"
          ],
          "enumDescriptions": [
            "If no browser is found, offer to download Chromium (chrome-headless-shell, about 126 MB) into VS Code's global storage.",
            "Never download Chromium. Show an error instead."
          ],
          "default": "ask",
          "scope": "application",
          "description": "What to do when no Chrome, Edge or Chromium installation is found."
        },
        "markdownPdfViewer.cacheDays": {
          "type": "integer",
          "default": 7,
          "minimum": 0,
          "maximum": 365,
          "scope": "application",
          "description": "How many days a converted PDF is kept after it was last opened, so reopening an unchanged Markdown or text file shows it instantly instead of converting it again. The cache lives in VS Code's storage for this extension, never in your folders. 0 turns the cache off and deletes it."
        },
        "markdownPdfViewer.textSnapshots": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Keep a compressed copy of a document's text for the versions its highlights, marker and drawings were last found in, so they can follow their text exactly when the file changes (also while VS Code was closed). The copies live in VS Code's storage for this extension, never in your folders, and only for files you annotated. Turning this off deletes them; annotations are then found again by searching for their text."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "markdownPdfViewer.pdf",
        "displayName": "Document Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:dev": "node esbuild.mjs --dev",
    "watch": "node esbuild.mjs --dev --watch",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:converter": "node esbuild.mjs && vitest run --config vitest.converter.config.mts",
    "package": "vsce package --githubBranch main",
    "vscode:prepublish": "node esbuild.mjs",
    "sounds": "node scripts/fetch-sounds.mjs"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@mdit/plugin-alert": "2.1.0",
    "@mdit/plugin-tasklist": "1.2.0",
    "@puppeteer/browsers": "3.2.6",
    "@types/markdown-it": "14.2.0",
    "@types/markdown-it-emoji": "3.0.1",
    "@types/markdown-it-footnote": "3.0.4",
    "@types/node": "22.20.5",
    "@types/vscode": "1.110.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/markdown-it-katex": "1.1.2",
    "@vscode/vsce": "4.1.0",
    "approx-string-match": "2.0.1",
    "esbuild": "0.28.2",
    "github-slugger": "2.0.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "markdown-it-anchor": "10.1.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-front-matter": "0.2.4",
    "mermaid": "12.3.0",
    "pdfjs-dist": "6.5.438",
    "puppeteer-core": "25.16.0",
    "shiki": "4.6.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@vscode/markdown-it-katex": {
      "katex": "$katex"
    }
  }
}
