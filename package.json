{
  "name": "reading-room",
  "displayName": "Reading Room",
  "description": "A quiet place to read and study inside VS Code. Open PDF, Markdown and text files as pages, highlight them, write notes, draw and type on them, keep your place, play rain or a fireplace while you read, and download it all as a PDF.",
  "version": "0.10.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArthurSudbrackIbarra/markdown-pdf-viewer.git"
  },
  "icon": "media/icon.png",
  "private": true,
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Education",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "reading",
    "study",
    "pdf",
    "markdown",
    "reader",
    "viewer",
    "highlight",
    "annotation",
    "notes",
    "drawing",
    "text box",
    "bookmark",
    "ambient sounds"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:readingRoom.preview",
    "onCustomEditor:readingRoom.pdf"
  ],
  "contributes": {
    "commands": [
      {
        "command": "readingRoom.openPreviewToSide",
        "title": "Open in Reading Room to the Side",
        "icon": "$(book)"
      },
      {
        "command": "readingRoom.openPreview",
        "title": "Open in Reading Room",
        "icon": "$(book)"
      },
      {
        "command": "readingRoom.showSource",
        "title": "Open Source File",
        "category": "Reading Room",
        "icon": "$(go-to-file)"
      },
      {
        "command": "readingRoom.toggleFullView",
        "title": "Toggle Full View",
        "category": "Reading Room",
        "icon": "$(screen-full)"
      },
      {
        "command": "readingRoom.refresh",
        "title": "Refresh the Document",
        "category": "Reading Room",
        "icon": "$(refresh)"
      },
      {
        "command": "readingRoom.download",
        "title": "Download as PDF",
        "category": "Reading Room",
        "icon": "$(desktop-download)"
      },
      {
        "command": "readingRoom.downloadWithoutHighlights",
        "title": "Download as PDF without Annotations",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.zoomIn",
        "title": "Zoom In",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.zoomOut",
        "title": "Zoom Out",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.toggleHighlightTool",
        "title": "Toggle Highlight Tool",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.toggleHighlightsList",
        "title": "Toggle Annotations List",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.toggleDrawing",
        "title": "Toggle Draw Mode",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.toggleText",
        "title": "Toggle Text Mode",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.toggleRemoveTool",
        "title": "Toggle Remove Tool",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.toggleDarkMode",
        "title": "Toggle Light/Dark Pages",
        "category": "Reading Room",
        "icon": "$(color-mode)"
      },
      {
        "command": "readingRoom.undo",
        "title": "Undo Highlight, Note, Marker, Drawing or Text Change",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.redo",
        "title": "Redo Highlight, Note, Marker, Drawing or Text Change",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.markReadingPosition",
        "title": "Mark Where I Stopped Reading",
        "category": "Reading Room",
        "icon": "$(bookmark)"
      },
      {
        "command": "readingRoom.goToReadingPosition",
        "title": "Go to Where I Stopped Reading",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.removeReadingPosition",
        "title": "Remove the Reading Marker",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.toggleSounds",
        "title": "Play/Pause Reading Sounds",
        "category": "Reading Room",
        "icon": "$(unmute)"
      },
      {
        "command": "readingRoom.addSounds",
        "title": "Add Reading Sounds from Files…",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.reattachHighlights",
        "title": "Reattach Annotations from Another File…",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.deleteAllHighlights",
        "title": "Delete All Highlights for This File",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.deleteAllDrawings",
        "title": "Delete All Drawings for This File",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.deleteAllTextBoxes",
        "title": "Delete All Text Boxes for This File",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.revealDataFolder",
        "title": "Reveal Annotation Data Folder",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.clearCache",
        "title": "Clear Cached Pages",
        "category": "Reading Room"
      },
      {
        "command": "readingRoom.showLog",
        "title": "Show Log",
        "category": "Reading Room"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "readingRoom.openPreviewToSide",
          "alt": "readingRoom.openPreview",
          "group": "navigation",
          "when": "(resourceLangId == markdown || resourceFilename =~ /\\.txt$/i) && config.readingRoom.defaultOpenMode != 'full'"
        },
        {
          "command": "readingRoom.openPreview",
          "alt": "readingRoom.openPreviewToSide",
          "group": "navigation",
          "when": "(resourceLangId == markdown || resourceFilename =~ /\\.txt$/i) && config.readingRoom.defaultOpenMode == 'full'"
        },
        {
          "command": "readingRoom.showSource",
          "group": "navigation",
          "when": "activeWebviewPanelId == 'readingRoom.preview'"
        }
      ],
      "explorer/context": [
        {
          "command": "readingRoom.openPreviewToSide",
          "group": "navigation@90",
          "when": "resourceLangId == markdown || resourceExtname =~ /^\\.(txt|pdf)$/i"
        }
      ],
      "commandPalette": [
        {
          "command": "readingRoom.openPreviewToSide",
          "when": "editorLangId == markdown || resourceFilename =~ /\\.txt$/i || resourceLangId == markdown || resourceFilename =~ /\\.txt$/i"
        },
        {
          "command": "readingRoom.openPreview",
          "when": "editorLangId == markdown || resourceFilename =~ /\\.txt$/i || resourceLangId == markdown || resourceFilename =~ /\\.txt$/i"
        },
        {
          "command": "readingRoom.showSource",
          "when": "activeWebviewPanelId == 'readingRoom.preview'"
        },
        {
          "command": "readingRoom.toggleFullView",
          "when": "activeWebviewPanelId == 'readingRoom.preview'"
        },
        {
          "command": "readingRoom.refresh",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.download",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.downloadWithoutHighlights",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.zoomIn",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.zoomOut",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.toggleHighlightTool",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.toggleHighlightsList",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.toggleDrawing",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.toggleText",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.toggleRemoveTool",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.toggleDarkMode",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.undo",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.redo",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.markReadingPosition",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.goToReadingPosition",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.removeReadingPosition",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.toggleSounds",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf' || readingRoom.soundPlaying"
        },
        {
          "command": "readingRoom.reattachHighlights",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.deleteAllHighlights",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.deleteAllDrawings",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        },
        {
          "command": "readingRoom.deleteAllTextBoxes",
          "when": "activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf'"
        }
      ]
    },
    "keybindings": [
      {
        "command": "readingRoom.openPreviewToSide",
        "key": "ctrl+k shift+r",
        "mac": "cmd+k shift+r",
        "when": "editorLangId == markdown || resourceFilename =~ /\\.txt$/i"
      },
      {
        "command": "readingRoom.openPreview",
        "key": "ctrl+shift+alt+r",
        "mac": "cmd+shift+alt+r",
        "when": "editorLangId == markdown || resourceFilename =~ /\\.txt$/i"
      },
      {
        "command": "readingRoom.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "(activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf') && readingRoom.viewerFocused"
      },
      {
        "command": "readingRoom.zoomIn",
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "when": "(activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf') && readingRoom.viewerFocused"
      },
      {
        "command": "readingRoom.zoomIn",
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "when": "(activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf') && readingRoom.viewerFocused"
      },
      {
        "command": "readingRoom.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "(activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf') && readingRoom.viewerFocused"
      },
      {
        "command": "readingRoom.zoomOut",
        "key": "ctrl+shift+-",
        "mac": "cmd+shift+-",
        "when": "(activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf') && readingRoom.viewerFocused"
      },
      {
        "command": "readingRoom.zoomOut",
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "when": "(activeWebviewPanelId == 'readingRoom.preview' || activeCustomEditorId == 'readingRoom.pdf') && readingRoom.viewerFocused"
      }
    ],
    "configuration": {
      "title": "Reading Room",
      "properties": {
        "readingRoom.defaultOpenMode": {
          "type": "string",
          "enum": [
            "side",
            "full"
          ],
          "enumDescriptions": [
            "The title-bar button opens the pages next to the Markdown or text editor. Alt+click opens them in the current editor group.",
            "The title-bar button opens the pages in the current editor group. Alt+click opens them to the side."
          ],
          "default": "side",
          "scope": "application",
          "description": "What the Reading Room button in the editor title bar does on a plain click."
        },
        "readingRoom.pageSize": {
          "type": "string",
          "enum": [
            "A4",
            "Letter"
          ],
          "default": "A4",
          "scope": "application",
          "description": "Paper size of the pages made from Markdown and text files."
        },
        "readingRoom.pageNumbers": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Print page numbers (\"n / N\") at the bottom of every page."
        },
        "readingRoom.renderOnSave": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Convert Markdown and text files again automatically when they are saved."
        },
        "readingRoom.allowRemoteImages": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Download http(s) images referenced by the Markdown and show them on the pages."
        },
        "readingRoom.chromiumPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to a Chrome, Edge or Chromium executable. Leave empty to detect an installed browser automatically."
        },
        "readingRoom.chromiumDownload": {
          "type": "string",
          "enum": [
            "ask",
            "never"
          ],
          "enumDescriptions": [
            "If no browser is found, offer to download Chromium (chrome-headless-shell, about 126 MB) into VS Code's global storage.",
            "Never download Chromium. Show an error instead."
          ],
          "default": "ask",
          "scope": "application",
          "description": "What to do when no Chrome, Edge or Chromium installation is found."
        },
        "readingRoom.cacheDays": {
          "type": "integer",
          "default": 7,
          "minimum": 0,
          "maximum": 365,
          "scope": "application",
          "description": "How many days the pages made from a Markdown or text file are kept after it was last opened, so reopening an unchanged file shows it instantly instead of converting it again. The cache lives in VS Code's storage for this extension, never in your folders. 0 turns the cache off and deletes it."
        },
        "readingRoom.textSnapshots": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Keep a compressed copy of a document's text for the versions its highlights, marker and drawings were last found in, so they can follow their text exactly when the file changes (also while VS Code was closed). The copies live in VS Code's storage for this extension, never in your folders, and only for files you annotated. Turning this off deletes them; annotations are then found again by searching for their text."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "readingRoom.pdf",
        "displayName": "Reading Room",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:dev": "node esbuild.mjs --dev",
    "watch": "node esbuild.mjs --dev --watch",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test": "vitest run",
    "test:converter": "node esbuild.mjs && vitest run --config vitest.converter.config.mts",
    "package": "vsce package --githubBranch main",
    "vscode:prepublish": "node esbuild.mjs",
    "sounds": "node scripts/fetch-sounds.mjs"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@eslint/js": "10.0.1",
    "@mdit/plugin-alert": "2.1.0",
    "@mdit/plugin-tasklist": "1.2.0",
    "@puppeteer/browsers": "3.2.6",
    "@types/markdown-it": "14.2.0",
    "@types/markdown-it-emoji": "3.0.1",
    "@types/markdown-it-footnote": "3.0.4",
    "@types/node": "22.20.5",
    "@types/vscode": "1.110.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/markdown-it-katex": "1.1.2",
    "@vscode/vsce": "4.1.0",
    "approx-string-match": "2.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "github-slugger": "2.0.0",
    "globals": "17.14.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "markdown-it-anchor": "10.1.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-front-matter": "0.2.4",
    "mermaid": "12.3.0",
    "pdfjs-dist": "6.5.438",
    "prettier": "3.10.1",
    "puppeteer-core": "25.16.0",
    "shiki": "4.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@vscode/markdown-it-katex": {
      "katex": "$katex"
    }
  }
}
